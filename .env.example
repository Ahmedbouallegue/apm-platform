# -----------------------------------------------------------------------------
# APM Platform — environment variables (copy to .env and adjust)
# -----------------------------------------------------------------------------

# Django
DEBUG=True
SECRET_KEY=change-me-dev-secret-key-apm-platform-2026
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=apm
POSTGRES_USER=apm
POSTGRES_PASSWORD=apm
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://apm:apm@db:5432/apm

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Ports (host)
WEB_PORT=8000
NGINX_HTTP_PORT=80
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Production TLS flags (activer derrière un reverse-proxy HTTPS)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Auth rate limiting
LOGIN_RATE_LIMIT_ENABLED=True
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Uploads (octets, défaut 10 Mo)
MAX_UPLOAD_SIZE_BYTES=10485760

# Prometheus (optionnel — scraper interne ou header X-Metrics-Token)
METRICS_TOKEN=
METRICS_ALLOWED_IPS=127.0.0.1,::1

# DRF throttling
DRF_THROTTLE_ANON=60/minute
DRF_THROTTLE_USER=300/minute

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Email (Gmail SMTP recommended for mot de passe oublié)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Topnet APM <noreply@example.com>
PASSWORD_RESET_TIMEOUT=86400
